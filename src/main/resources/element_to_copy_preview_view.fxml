   <columnConstraints>
      <ColumnConstraints percentWidth="15" />
      <ColumnConstraints percentWidth="85" />
   </columnConstraints>

   <children>
      <Label fx:id="idLabel" prefHeight="60" GridPane.columnIndex="0">
         <font>
            <Font size="64.0" />
         </font></Label>
      <Label fx:id="nameLabel" alignment="CENTER" prefHeight="60" stylesheets="@style.css" GridPane.columnIndex="1">
         <font>
            <Font size="48.0" />
         </font></Label>
   </children>
   <rowConstraints>
      <RowConstraints />
   </rowConstraints>
</GridPane>
